# Backup & sync (optional). Without these, KeyHaven keeps everything on this device.
# DATABASE_URL: a Neon Postgres connection string. Then run `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host/keyhaven?sslmode=require
NEXT_PUBLIC_KEYHAVEN_SYNC=true
# Generate with `npx auth secret`.
AUTH_SECRET=replace-with-a-random-secret

# Optional: Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: password reset email through Resend
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=KeyHaven <hello@example.com>
